# ─────────────────────────────────────────────────────────────────────────────
# RentRight GH — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is in .gitignore — never commit real secrets.
#
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ─── Django core ──────────────────────────────────────────────────────────────
# Generate a new key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=gvkhvfxtcybvdxgvu

# Settings module — switch to production when deploying
DJANGO_SETTINGS_MODULE=config.settings.staging

# Comma-separated — no spaces
# Development:   ALLOWED_HOSTS=localhost,127.0.0.1
# Production:    ALLOWED_HOSTS=rentright.gh,www.rentright.gh
ALLOWED_HOSTS=*

# ─── Database (production only — ignored in development SQLite mode) ──────────
# Railway.app sets this automatically. For DigitalOcean, copy from your
# Managed Database panel.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://user:password@localhost:5432/rentright

# ─── Paystack 
PAYSTACK_SECRET_KEY=sk_test_7256afcc85e225b944494ce2e37e1b38fc7c55ec
PAYSTACK_PUBLIC_KEY=pk_test_your_paystack_public_key

# ─── Arkesel SMS ──────────────────────────────────────────────────────────────
# https://account.arkesel.com/dashboard
ARKESEL_API_KEY=Z2pDQ1dzTlNadVVValNLTEdJZ3Q
ARKESEL_SENDER_NAME=RentRight
ARKESEL_SENDER_ID=RentRight

# ─── Cloudinary (production media storage) ────────────────────────────────────
